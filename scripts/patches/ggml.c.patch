+    // (montée vers v0.7.0, mesuré sur le téléphone le 2026-10-24).
+    if (strchr(fname, '/') == NULL) {
+        char *endptr;
+        long num = strtol(fname, &endptr, 10);
+        if (endptr != fname && *endptr == '\0') {
+            FILE *file = fdopen(dup(num), mode);
+            if (file != NULL) {
