+// Cette opération vaut-elle le voyage jusqu'au GPU, alors que ses poids sont
+// restés en mémoire hôte ?
+//
+// Ajouté pour ce projet (2026-10-25). Le backend OpenCL laissait ce rappel à
+// NULL, et le planificateur n'avait donc que deux positions : poids en RAM et
+// GPU jamais sollicité, ou couches déportées et GPU chargé de TOUT, décodage
+// compris. Mesuré sur Adreno 732 avec Qwen2.5-1.5B : tout sur le GPU donne
+// 4,4 jetons/s contre 23,7 au processeur, parce qu'un décodage à un jeton est
+// limité par la bande passante et que le GPU y perd. Le gain du GPU est dans
+// les GROS lots — la lecture de l'invite.
+//
+// Même règle que le backend CUDA, qui porte ce rappel depuis longtemps : à
+// partir de 32 lignes, l'opération part sur le GPU ; en dessous, elle reste
+// sur le processeur. `GET_ROWS` est exclue : elle ne calcule rien, elle
+// recopie, et la faire voyager coûterait plus que de la laisser sur place.
+static bool lm_ggml_backend_opencl_device_offload_op(lm_ggml_backend_dev_t dev, const lm_ggml_tensor * op) {
+    LM_GGML_UNUSED(dev);
+
+    static const int lot_minimal = 32;
+
+    if (op->op == LM_GGML_OP_GET_ROWS) {
+        return false;
+    }
+    return op->ne[1] >= lot_minimal || op->ne[2] >= lot_minimal;
+}
